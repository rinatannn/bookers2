<div class="container">
  <div class="row">
    <div class="col-md-8 offset-md-2">

      <h2 class="mt-4 mb-4">Log in</h2>

      <%= form_with scope: :user,
                    url: user_session_path,
                    method: :post,
                    local: true do |f| %>

        <div class="form-group">
          <%= f.label :name, "Name" %>
          <%= f.text_field :name,
                           placeholder: "name",
                           class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :password, "Password" %>
          <%= f.password_field :password,
                               placeholder: "password",
                               class: "form-control" %>
        </div>

        <%= f.submit "Log in", class: "btn btn-info" %>

      <% end %>

    </div>
  </div>
</div>