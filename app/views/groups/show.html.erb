<div class="container px-5 px-sm-0 mt-3">
  <div class="row">

    <div class="col-md-3">
      <h2>User info</h2>
      <%= render "users/info", user: @user, book: Book.new %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2>Group Detail</h2>

      <table class="table">
        <thead>
          <tr>
            <th>Group name</th>
            <th>Introduction</th>
            <th>Owner</th>
            <th>Members</th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <tr>
            <td><%= @group.name %></td>
            <td><%= @group.introduction %></td>
            <td><%= @group.owner.name %></td>
            <td><%= @group.users.count %></td>

            <td>
              <% if @group.owner == current_user %>
                <%= link_to "Edit",
                            edit_group_path(@group),
                            class: "btn btn-success btn-sm" %>

                <%= link_to "Notice an Event",
                            new_mail_group_path(@group),
                            class: "btn btn-info btn-sm" %>

              <% elsif @group.includes_user?(current_user) %>
                <%= link_to "Leave this group",
                            group_group_users_path(@group),
                            data: { turbo_method: :delete },
                            class: "btn btn-danger btn-sm" %>

              <% else %>
                <%= link_to "Join this group",
                            group_group_users_path(@group),
                            data: { turbo_method: :post },
                            class: "btn btn-success btn-sm" %>
              <% end %>
            </td>
          </tr>
        </tbody>
      </table>

      <h3>Group Members</h3>

      <table class="table">
        <thead>
          <tr>
            <th>Name</th>
          </tr>
        </thead>

        <tbody>
          <% @group.users.each do |user| %>
            <tr>
              <td>
                <%= link_to user.name, user_path(user) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <%= link_to "Back to Groups",
                  groups_path,
                  class: "btn btn-secondary" %>
    </div>

  </div>
</div>