<div class="container px-5 px-sm-0 mt-3">
  <div class="row">

    <div class="col-md-3">
      <h2>User info</h2>
      <%= render "users/info", user: @user, book: Book.new %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2>Event Mail</h2>

      <%= form_with url: send_mail_group_path(@group),
              method: :post,
              local: true,
              data: { turbo: false } do |f| %>

        <div class="form-group">
          <%= f.label :title, "Title" %>
          <%= f.text_field :title, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :body, "Body" %>
          <%= f.text_area :body, class: "form-control", rows: 6 %>
        </div>

        <div class="form-group">
          <%= f.submit "Send", class: "btn btn-success" %>
        </div>

      <% end %>

      <%= link_to "Back", group_path(@group) %>
    </div>

  </div>
</div>