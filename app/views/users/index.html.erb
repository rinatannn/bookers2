<div class="container px-5 px-sm-0 mt-3">
  <div class="row">

    <div class="col-md-3">
      <%= render 'info', user: @user, book: @book %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2 class="mt-3">Users</h2>

      <table class="table">
        <thead>
          <tr>
            <th>image</th>
            <th>name</th>
            <th>follows</th>
            <th>followers</th>
            <th></th>
            <th></th>
          </tr>
        </thead>

        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td>
                <% if user.profile_image.attached? %>
                  <%= image_tag user.profile_image, size: "40x40" %>
                <% else %>
                  <%= image_tag "no_image.svg", size: "40x40" %>
                <% end %>
              </td>

              <td>
                <%= user.name %>
              </td>

              <td>
                <%= link_to user.followings.count, followings_user_path(user) %>
              </td>

              <td>
                <%= link_to user.followers.count, followers_user_path(user) %>
              </td>

              <td>
                <%= render "users/follow_btn", user: user %>
              </td>

              <td>
                <%= link_to 'Show', user_path(user) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>
</div>