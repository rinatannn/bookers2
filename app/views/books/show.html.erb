<div class="container">
  <div class="row">
    <div class="col-md-3">
      <%= render 'books/list', user: @book.user, book: Book.new %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2>Book detail</h2>

      <table class="table">
        <tbody>
          <tr>
            <td>
              <%= link_to user_path(@book.user) do %>
                <% if @book.user.profile_image.attached? %>
                  <%= image_tag @book.user.profile_image, size: "40x40" %><br>
                <% else %>
                  <%= image_tag "no_image.svg", size: "40x40" %><br>
                <% end %>

                <%= @book.user.name %>
              <% end %>
            </td>

            <td>
              <%= link_to @book.title, book_path(@book) %>
            </td>

            <td>
              <%= @book.body %>
            </td>

            <td>
              <% if @book.favorited_by?(current_user) %>
                <%= button_to "♥ #{@book.favorites.count}",
                              book_favorite_path(@book),
                              method: :delete %>
              <% else %>
                <%= button_to "♡ #{@book.favorites.count}",
                              book_favorite_path(@book),
                              method: :post %>
              <% end %>
            </td>

            <td>
              コメント数: <%= @book.book_comments.count %>
            </td>

            <% if @book.user == current_user %>
              <td>
                <%= link_to 'Edit',
                            edit_book_path(@book),
                            class: "btn btn-sm btn-success" %>
              </td>

              <td>
                <%= link_to 'Destroy',
                            book_path(@book),
                            data: {
                              turbo_method: :delete,
                              turbo_confirm: '本当に消しますか？'
                            },
                            class: "btn btn-sm btn-danger" %>
              </td>
            <% end %>
          </tr>
        </tbody>
      </table>

      <div class="book-comments">
        <% @book.book_comments.each do |book_comment| %>
          <div class="mb-3">
            <%= link_to user_path(book_comment.user) do %>
              <% if book_comment.user.profile_image.attached? %>
                <%= image_tag book_comment.user.profile_image, size: "40x40" %>
              <% else %>
                <%= image_tag "no_image.svg", size: "40x40" %>
              <% end %>

              <%= book_comment.user.name %>
            <% end %>

            <%= book_comment.comment %>

            <% if book_comment.user == current_user %>
              <%= button_to "Destroy",
                            book_book_comment_path(@book, book_comment),
                            method: :delete,
                            class: "btn btn-sm btn-danger" %>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="new-comment">
        <%= form_with model: [@book, BookComment.new] do |f| %>
          <div class="form-group">
            <%= f.text_area :comment,
                            rows: "5",
                            class: "form-control",
                            placeholder: "コメントをここに" %>
          </div>

          <%= f.submit "送信", class: "btn btn-success mt-2" %>
        <% end %>
      </div>

    </div>
  </div>
</div>