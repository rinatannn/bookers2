<div class="container px-5 px-sm-0 mt-3">
  <div class="row">

    <div class="col-md-3">
      <h2>User info</h2>
      <%= render "users/info", user: @user, book: Book.new %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2>Editing Group</h2>

      <% if @group.errors.any? %>
        <div class="alert alert-danger">
          <ul>
            <% @group.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @group, local: true do |f| %>

        <div class="form-group">
          <%= f.label :name, "Group name" %>
          <%= f.text_field :name, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.label :introduction, "Introduction" %>
          <%= f.text_area :introduction, class: "form-control" %>
        </div>

        <div class="form-group">
          <%= f.submit "Update Group", class: "btn btn-success" %>
        </div>

      <% end %>

      <%= link_to "Show", group_path(@group) %> |
      <%= link_to "Back", groups_path %>
    </div>

  </div>
</div>