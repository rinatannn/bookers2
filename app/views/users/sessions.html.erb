<div class="container">
  <div class="row">
    <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0 mx-auto">
      <h2>Log in</h2>
      <%= form_with url: user_session_path, local: true do |f| %>
        <div class="field">
          <%= f.label :name %><br />
          <%= f.text_field :name, class: "name" %>
        </div>

        <div class="field">
          <%= f.label :password %><br />
          <%= f.password_field :password, class: "password" %>
        </div>

        <div class="actions">
          <%= f.submit "Log in", class: "btn btn-sm btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
