<div class="container px-5 px-sm-0 mt-3">
 <div class="row">

   <!-- 💡左側のエリア：新規投稿フォーム（横幅: 3個分） -->
   <div class="col-md-3">
   <%= render 'users/info', user: @user, book: @book %>
</div>

<!-- 💡右側のエリア：投稿された本の一覧（横幅: 9個分、少し隙間をあける） -->
<div class="col-md-8 offset-md-1">
 <h2 class="mt-3">Books</h2>
 <table class="table table-hover table-inverse">
  <thead>''
   <tr>
    <th></th>
    <th>Title</th>
    <th>Opinion</th>
  </tr>
</thead>
<tbody>
  <% @books.each do |book| %>
    <tr>
     <td>
      <!-- 💡後でここにユーザーのプロフィール画像が入ります -->
      アイコン placeholder
      </td>
      <td><%= book.title %></td>
      <td><%= book.body %></td>
      <td><%= link_to "Show", book_path(book) %></td>
      <td><%= link_to "Edit", edit_book_path(book) %></td>
    </tr>
  <% end %>
</tbody>
</table>
</div>

</div>
</div>
