<%= form_with model: [book, book_comment] do |f| %>
  <div class="form-group">
    <%= f.text_area :comment,
                    rows: "5",
                    class: "form-control",
                    placeholder: "コメントをここに" %>
  </div>

  <%= f.submit "送信", class: "btn btn-success mt-2" %>
<% end %>