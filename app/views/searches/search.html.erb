<div class="container mt-3">

  <% if @range == "User" %>

    <h2>Users search for "<%= @word %>"</h2>

    <table class="table">
      <thead>
        <tr>
          <th>image</th>
          <th>name</th>
          <th>follows</th>
          <th>followers</th>
          <th></th>
          <th></th>
        </tr>
      </thead>

      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td>
              <% if user.profile_image.attached? %>
                <%= image_tag user.profile_image, size: "40x40" %>
              <% else %>
                <%= image_tag "no_image.svg", size: "40x40" %>
              <% end %>
            </td>

            <td>
              <%= user.name %>
            </td>

            <td>
              <%= link_to user.followings.count, followings_user_path(user) %>
            </td>

            <td>
              <%= link_to user.followers.count, followers_user_path(user) %>
            </td>

            <td>
              <%= render "users/follow_btn", user: user %>
            </td>

            <td>
              <%= link_to "Show", user_path(user) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

  <% else %>

    <h2>Books search for "<%= @word %>"</h2>

    <table class="table">
      <thead>
        <tr>
          <th></th>
          <th>Title</th>
          <th>Opinion</th>
        </tr>
      </thead>

      <tbody>
        <% @books.each do |book| %>
          <tr>
            <td>
              <%= link_to user_path(book.user) do %>
                <% if book.user.profile_image.attached? %>
                  <%= image_tag book.user.profile_image, size: "40x40" %>
                <% else %>
                  <%= image_tag "no_image.svg", size: "40x40" %>
                <% end %>
              <% end %>
            </td>

            <td>
              <%= link_to book.title, book_path(book) %>
            </td>

            <td>
              <%= book.body %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

  <% end %>

</div>