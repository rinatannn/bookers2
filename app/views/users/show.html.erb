<div class="container">
  <div class="row">
    <div class="col-md-3">
      <h2>User info</h2>

      <% if @user.profile_image.attached? %>
        <%= image_tag @user.profile_image, size: "100x100" %>
      <% else %>
        <%= image_tag "no_image.svg", size: "100x100" %>
      <% end %>

      <table class="table">
        <tbody>
          <tr>
            <th>name</th>
            <th><%= @user.name %></th>
          </tr>

          <tr>
            <th>introduction</th>
            <th><%= @user.introduction %></th>
          </tr>

          <tr>
            <th>follows</th>
            <th>
              <%= link_to @user.followings.count, followings_user_path(@user) %>
            </th>
          </tr>

          <tr>
            <th>followers</th>
            <th>
              <%= link_to @user.followers.count, followers_user_path(@user) %>
            </th>
          </tr>
        </tbody>
      </table>

      <%= render "users/follow_btn", user: @user %>

      <% if current_user != @user &&
            current_user.following?(@user) &&
            @user.following?(current_user) %>
        <div class="mt-2">
          <%= button_to "DM",
                        user_rooms_path(@user),
                        method: :post,
                        class: "btn btn-primary btn-block" %>
        </div>
      <% end %>

      <% if current_user == @user %>
        <div class="row mt-2">
          <%= link_to edit_user_path(@user),
                      class: "btn btn-outline-secondary btn-block" do %>
            <i class="fas fa-user-cog"></i>
          <% end %>
        </div>
      <% end %>

      <h2 class="mt-3">New book</h2>

      <%= form_with model: Book.new, local: true do |f| %>
        <div class="form-group">
          <%= f.label :title %>
          <%= f.text_field :title, class: "form-control book_title" %>
        </div>

        <div class="form-group">
          <%= f.label :body, "Opinion" %>
          <%= f.text_area :body, class: "form-control book_body" %>
        </div>

        <div class="form-group">
          <label>Rating</label>
          <div id="post_raty"></div>
        </div>

        <div class="form-group">
          <%= f.submit "Create Book", class: "btn btn-success" %>
        </div>
      <% end %>
    </div>

    <div class="col-md-8 offset-md-1">
      <h2>Books</h2>

      <table class="table table-hover table-inverse">
        <thead>
          <tr>
            <th></th>
            <th>Title</th>
            <th>Opinion</th>
            <th>Rating</th>
            <th>Comments</th>
          </tr>
        </thead>

        <tbody>
          <% @user.books.each do |book| %>
            <tr>
              <td>
                <%= link_to user_path(book.user) do %>
                  <% if book.user.profile_image.attached? %>
                    <%= image_tag book.user.profile_image, size: "40x40" %>
                  <% else %>
                    <%= image_tag "no_image.svg", size: "40x40" %>
                  <% end %>
                <% end %>
              </td>

              <td>
                <%= link_to book.title, book_path(book) %>
              </td>

              <td>
                <%= book.body %>
              </td>

              <td>
                <% if book.score.present? %>
                  <div
                    class="book-rating"
                    data-score="<%= book.score %>">
                  </div>
                <% end %>
              </td>

              <td>
                コメント数: <%= book.book_comments.count %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <!-- record-1 -->
      <h2 class="mt-4">投稿数の比較</h2>

      <table class="table table-bordered">
        <thead>
          <tr>
            <th>今日の投稿数</th>
            <th>前日の投稿数</th>
            <th>前日比</th>
          </tr>
        </thead>

        <tbody>
          <tr>
            <td><%= @today_book_count %></td>
            <td><%= @yesterday_book_count %></td>

            <td>
              <% if @yesterday_book_count.zero? %>
                比較できません
              <% else %>
                <%= @day_comparison %>%
              <% end %>
            </td>
          </tr>
        </tbody>
      </table>

      <table class="table table-bordered">
        <thead>
          <tr>
            <th>今週の投稿数</th>
            <th>先週の投稿数</th>
            <th>先週比</th>
          </tr>
        </thead>

        <tbody>
          <tr>
            <td><%= @this_week_book_count %></td>
            <td><%= @last_week_book_count %></td>

            <td>
              <% if @last_week_book_count.zero? %>
                比較できません
              <% else %>
                <%= @week_comparison %>%
              <% end %>
            </td>
          </tr>
        </tbody>
      </table>

      <!-- record-2 -->
      <h2 class="mt-4">過去7日間の投稿数</h2>

      <table class="table table-bordered">
        <thead>
          <tr>
            <% @dates.each do |date| %>
              <th><%= date.strftime("%m/%d") %></th>
            <% end %>
          </tr>
        </thead>

        <tbody>
          <tr>
            <% @daily_book_counts.each do |count| %>
              <td><%= count %></td>
            <% end %>
          </tr>
        </tbody>
      </table>

      <div class="mt-4">
        <canvas id="bookChart"></canvas>
      </div>

      <!-- record-3 -->
      <h2 class="mt-5">指定日の投稿数</h2>

      <%= form_with url: search_count_user_path(@user),
                    method: :get,
                    data: { turbo_stream: true } do |f| %>

        <div class="form-group">
          <%= f.date_field :date,
                           value: Date.current,
                           class: "form-control" %>
        </div>

        <%= f.submit "表示", class: "btn btn-primary" %>
      <% end %>

      <div id="search-count-result" class="mt-3">
      </div>

    </div>
  </div>
</div>

<script>
  document.addEventListener("turbo:load", function() {
    const canvas = document.getElementById("bookChart");

    if (!canvas) return;

    if (window.bookChart instanceof Chart) {
      window.bookChart.destroy();
    }

    window.bookChart = new Chart(canvas, {
      type: "line",

      data: {
        labels: <%= raw @dates.map { |date| date.strftime("%m/%d") }.to_json %>,

        datasets: [{
          label: "投稿数",
          data: <%= raw @daily_book_counts.to_json %>,
          tension: 0.1
        }]
      },

      options: {
        responsive: true,

        scales: {
          y: {
            beginAtZero: true,

            ticks: {
              stepSize: 1
            }
          }
        }
      }
    });
  });
</script>