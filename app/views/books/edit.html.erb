<div class="container mt-3">
  <div class="row">
    <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0 mx-auto">
      <h2>Editing Book</h2>

      <!-- 💡 エラーメッセージ表示（本の投稿と同じ形式） -->
      <% if @book.errors.any? %>
        <div id="error_explanation" class="alert alert-danger">
          <h3><%= @book.errors.count %> errors prohibited this book from being saved:</h3>
          <ul>
            <% @book.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- 💡 編集フォーム -->
      <%= form_with model: @book, data: { turbo: false } do |f| %>
        <div class="form-group mb-3">
          <%= f.label :title, "Title" %>
          <%= f.text_field :title, class: "form-control" %>
        </div>
        <div class="form-group mb-3">
          <%= f.label :body, "Opinion" %>
          <%= f.text_area :body, class: "form-control" %>
        </div>
        <div class="form-group mb-3">
          <%= f.submit "Update Book", class: "btn btn-success" %>
        </div>
      <% end %>

      <!-- 💡 詳細画面（Show）と一覧画面（Back）へのリンク -->
      <%= link_to "Show", book_path(@book) %> |
      <%= link_to "Back", books_path %>
    </div>
  </div>
</div>

