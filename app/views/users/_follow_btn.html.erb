<% unless current_user == user %>
  <% if current_user.following?(user) %>
    <%= link_to "Unfollow",
                user_relationships_path(user),
                data: { turbo_method: :delete },
                class: "btn btn-danger" %>
  <% else %>
    <%= link_to "Follow",
                user_relationships_path(user),
                data: { turbo_method: :post },
                class: "btn btn-success" %>
  <% end %>
<% end %>