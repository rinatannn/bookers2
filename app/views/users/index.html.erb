<div class="container px-5 px-sm-0 mt-3">
  <div class="row">

    <!-- 💡 左側のエリア：部分テンプレートの呼び出し -->
    <div class="col-md-3">
      <%= render 'info', user: @user, book: @book %>
    </div>

    <!-- 💡 右側のエリア：ユーザー一覧 -->
    <div class="col-md-8 offset-md-1">
      <h2 class="mt-3">Users</h2>
      <table class="table">
        <thead>
          <tr>
            <th>image</th>
            <th>name</th>
            <th colspan="3"></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr>
              <td>
                <!-- 💡 後でここにプロフィール画像が入ります -->
                アイコン placeholder
              </td>
              <td><%= user.name %></td>
              <td><%= link_to 'Show', user_path(user) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

  </div>
</div>

